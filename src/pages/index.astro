---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Sidebar from '../components/Sidebar.astro';
import Section from '../components/Section.astro';
import Footer from '../components/Footer.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectItem from '../components/ProjectItem.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { cv } from '../data/cv';
---

<Base title={`${cv.name} — ${cv.role}`} description={cv.summary}>
  <div class="page">
    <Masthead current="cv" />

    <main class="layout">
      <Sidebar />

      <div class="content">
        <Section label="Experience">
          {cv.experience.map((job) => <ExperienceItem job={job} />)}
        </Section>

        <Section label="Projects">
          {cv.projects.map((project) => <ProjectItem project={project} />)}
        </Section>

        <Section label="Skills">
          <div class="skills">
            {cv.skills.map((group) => <SkillGroup group={group} />)}
          </div>
        </Section>

        <Section label="Education">
          {
            cv.education.map((entry) => (
              <div class="exp">
                <div>
                  <h3 class="exp__title">{entry.school}</h3>
                  <p class="exp__meta">{entry.dates}</p>
                  <p class="exp__meta">{entry.location}</p>
                </div>
                <div>
                  <p>{entry.degree}</p>
                  {entry.detail && <p class="edu__minor">{entry.detail}</p>}
                </div>
              </div>
            ))
          }
        </Section>

        <Section label="Recommendations">
          <div class="cols">
            {
              cv.recommendations.map((quote) => (
                <figure class="quote">
                  <blockquote class="quote__text">&ldquo;{quote.text}&rdquo;</blockquote>
                  <figcaption class="quote__attr">
                    {quote.name}
                    <br />
                    {quote.role}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </Section>

        <section class="section">
          <div class="cols">
            <div>
              <h2 class="section__label">Certifications</h2>
              {
                cv.certifications.map((cert) => (
                  <div class="cert">
                    <h3 class="exp__title">{cert.name}</h3>
                    <p class="exp__meta">
                      {cert.issuer} · {cert.date}
                    </p>
                    {cert.detail && <p class="cert__detail">{cert.detail}</p>}
                    {cert.url && (
                      <a class="cert__link" href={cert.url} target="_blank" rel="noopener noreferrer">
                        View certificate <span class="arrow">↗</span>
                      </a>
                    )}
                  </div>
                ))
              }
            </div>

            <div>
              <h2 class="section__label">Languages</h2>
              <ul class="langs">
                {
                  cv.languages.map((language) => (
                    <li>
                      <span>{language.name}</span>
                      <span class="langs__level">{language.level}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>
      </div>
    </main>

    <Footer />
  </div>
</Base>
